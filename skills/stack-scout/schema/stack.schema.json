{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "facts_as_of",
    "partial",
    "unchecked",
    "assumed",
    "layers",
    "capabilities",
    "accepted",
    "cost"
  ],
  "properties": {
    "schema": {
      "enum": [
        1
      ]
    },
    "facts_as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "partial": {
      "type": "boolean"
    },
    "unchecked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "answer"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "question": {
            "type": "string"
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer",
          "choice",
          "reason",
          "alternative",
          "projects",
          "services",
          "risks"
        ],
        "properties": {
          "layer": {
            "type": "string"
          },
          "choice": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "alternative": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "why_not"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "why_not": {
                "type": "string"
              }
            }
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subject"
              ],
              "properties": {
                "subject": {
                  "type": "string",
                  "pattern": "^github:[^/\\s]+/[^/\\s]+$"
                }
              }
            }
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subject"
              ],
              "properties": {
                "subject": {
                  "type": "string",
                  "pattern": "^price:\\S+$"
                }
              }
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "layer",
          "outcome"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "layer": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "project",
              "service",
              "build-yourself"
            ]
          }
        }
      }
    },
    "accepted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "what"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "pattern": "^(github:[^/\\s]+/[^/\\s]+|osv:[^/\\s]+/\\S+|price:\\S+)$"
          },
          "what": {
            "type": "string"
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monthly_estimate",
        "currency",
        "parts",
        "unknown_parts"
      ],
      "properties": {
        "monthly_estimate": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": "string"
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subject",
              "monthly"
            ],
            "properties": {
              "subject": {
                "type": "string",
                "pattern": "^(github:[^/\\s]+/[^/\\s]+|osv:[^/\\s]+/\\S+|price:\\S+)$"
              },
              "monthly": {
                "type": "number"
              }
            }
          }
        },
        "unknown_parts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(github:[^/\\s]+/[^/\\s]+|osv:[^/\\s]+/\\S+|price:\\S+)$"
          }
        }
      }
    }
  }
}
